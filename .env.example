# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
# Leave empty to use gpt-5.4-mini (OpenAI key) or claude-haiku-5-5 (Anthropic key).
# Model names starting with "claude" use Anthropic; anything else uses OpenAI.
DEFAULT_MODEL=
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=4096

# Agent Configuration
MAX_ITERATIONS=10
ENABLE_MEMORY=true
MEMORY_TYPE=chromadb

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
