# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
DEFAULT_MODEL=gpt-4-turbo-preview
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=4096

# Agent Configuration
MAX_ITERATIONS=10
ENABLE_MEMORY=true
MEMORY_TYPE=chromadb

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
